{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.14.0",
    "npm": "^10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.{css,scss}\" && prettier --write .",
    "test": "jest",
    "prepare": "husky",
    "pre-commit": "npm run lint:fix  && npm run test && npm run build"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": "stylelint --fix",
    "*.{html,json}": "prettier --write"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@jest/globals": "^30.0.4",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "babel-jest": "^30.0.4",
    "chai": "^5.2.1",
    "eslint": "^9.30.1",
    "globals": "^16.0.0",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "jest": "30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "jiti": "^2.4.2",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.1",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "sass": "^1.85.1",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^38.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.29.1",
    "uuid": "^11.1.0",
    "vite": "^6.2.0",
    "vite-plugin-handlebars": "^1.5.0"
  }
}
